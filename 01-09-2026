# =====================================================
# REGISTER
# =====================================================

@auth_bp.route("/register", defaults={"role": "user"}, methods=["GET", "POST"])
@auth_bp.route("/register/<role>", methods=["GET", "POST"])
def register(role):

    if request.method == "GET":
        return render_template("register.html", role=role)

    role = request.form.get("role", role)

    name = request.form.get("name")
    email = request.form.get("email")
    phone = request.form.get("phone")
    password = request.form.get("password")
    confirm_password = request.form.get("confirm_password")

    if password != confirm_password:
        flash("Passwords do not match.")
        return redirect(url_for("auth.register", role=role))

    # 🔥 FIX: Handle existing users correctly
    existing_user = User.query.filter_by(email=email).first()

    if existing_user:

        if existing_user.is_verified:
            flash("Email already registered.")
            return redirect(url_for("auth.register", role=role))

        else:
            # ✅ NOT VERIFIED → RESEND EMAIL
            send_verification_email(existing_user)

            return render_template(
                "verification_sent.html",
                title="Verification Email Resent",
                message="A new verification link has been sent to:",
                email=existing_user.email
            )

    # Phone check
    if phone:
        if User.query.filter_by(phone=phone).first():
            flash("Phone number already registered.")
            return redirect(url_for("auth.register", role=role))

    user = User(
        role=role,
        name=name,
        email=email,
        phone=phone,
        is_verified=False
    )

    if role == "police":
        user.police_id = generate_police_id()
        user.is_approved = False
    else:
        user.reference_id = generate_reference_id()

    user.set_password(password)

    db.session.add(user)
    db.session.commit()

    send_verification_email(user)

    return render_template(
        "verification_sent.html",
        title="Verification Email Sent",
        message="We've sent a verification link to:",
        email=user.email
    )


# =====================================================
# LOGIN
# =====================================================

@auth_bp.route("/login", defaults={"role": "user"}, methods=["GET", "POST"])
@auth_bp.route("/login/<role>", methods=["GET", "POST"])
def login(role):

    if request.method == "GET":
        return render_template("login.html", role=role)

    role = request.form.get("role", role)

    contact = request.form.get("contact")
    password = request.form.get("password")

    user = User.query.filter(
        or_(
            User.email == contact,
            User.phone == contact
        ),
        User.role == role
    ).first()

    if user is None:
        flash("Account not found.")
        return redirect(url_for("auth.login", role=role))

    if not user.check_password(password):
        flash("Incorrect password.")
        return redirect(url_for("auth.login", role=role))

    if not user.is_verified:
        flash("Please verify your email first.")
        return redirect(url_for("auth.login", role=role))

    if role == "police" and not user.is_approved:
        flash("Police account is awaiting admin approval.")
        return redirect(url_for("auth.login", role=role))

    login_user(user)

    if role == "police":
        return redirect("/police_dashboard")

    return redirect("/dashboard")


