<div class="container">

    <h1>INDICA</h1>

    <div class="subtitle">
        Audio Fraud Detection System
    </div>

    <input
        type="file"
        id="audioFile"
        accept="audio/*"
    >

    <button
        id="analyzeButton"
        onclick="analyzeAudio()"
    >
        Analyze Audio
    </button>

    <div id="status"></div>

    <div id="result">

        <div class="result-title">
            Prediction
        </div>

        <div
            id="prediction"
            class="result-value"
        >
        </div>

        <div
            id="confidence"
            class="probability"
        >
        </div>

        <div
            id="legitProbability"
            class="probability"
        >
        </div>

        <div
            id="fraudProbability"
            class="probability"
        >
        </div>

    </div>

</div>


<script>

    async function analyzeAudio() {

        const fileInput =
            document.getElementById("audioFile");

        const button =
            document.getElementById("analyzeButton");

        const status =
            document.getElementById("status");

        const result =
            document.getElementById("result");


        // ------------------------------------------------
        // Check whether an audio file was selected
        // ------------------------------------------------

        if (fileInput.files.length === 0) {

            status.innerText =
                "Please select an audio file.";

            return;
        }


        const audioFile =
            fileInput.files[0];


        // ------------------------------------------------
        // Prepare uploaded audio
        // ------------------------------------------------

        const formData =
            new FormData();

        formData.append(
            "audio",
            audioFile
        );


        // ------------------------------------------------
        // Update interface
        // ------------------------------------------------

        button.disabled = true;

        button.innerText =
            "Analyzing...";

        status.innerText =
            "Please wait while the audio is being analyzed.";

        result.style.display =
            "none";


        try {

            // --------------------------------------------
            // Send audio to Flask backend
            // --------------------------------------------

            const response =
                await fetch(
                    "/predict",
                    {
                        method: "POST",
                        body: formData
                    }
                );


            // --------------------------------------------
            // Convert response to JSON
            // --------------------------------------------

            const data =
                await response.json();


            // --------------------------------------------
            // Check for backend error
            // --------------------------------------------

            if (!response.ok) {

                throw new Error(
                    data.error ||
                    "Prediction failed."
                );
            }


            // --------------------------------------------
            // Display prediction
            // --------------------------------------------

            document.getElementById(
                "prediction"
            ).innerText =
                data.prediction;


            // --------------------------------------------
            // Display confidence
            // --------------------------------------------

            document.getElementById(
                "confidence"
            ).innerText =
                "Confidence: " +
                (
                    data.confidence * 100
                ).toFixed(2) +
                "%";


            // --------------------------------------------
            // Display legitimate probability
            // --------------------------------------------

            document.getElementById(
                "legitProbability"
            ).innerText =
                "Legit Probability: " +
                (
                    data.legit_probability * 100
                ).toFixed(2) +
                "%";


            // --------------------------------------------
            // Display fraud probability
            // --------------------------------------------

            document.getElementById(
                "fraudProbability"
            ).innerText =
                "Fraud Probability: " +
                (
                    data.fraud_probability * 100
                ).toFixed(2) +
                "%";


            // --------------------------------------------
            // Show result
            // --------------------------------------------

            result.style.display =
                "block";

            status.innerText =
                "Analysis completed successfully.";


        } catch (error) {

            status.innerText =
                "Error: " +
                error.message;

            result.style.display =
                "none";

        }


        // ------------------------------------------------
        // Enable button again
        // ------------------------------------------------

        button.disabled = false;

        button.innerText =
            "Analyze Audio";
    }

</script>


</body>

